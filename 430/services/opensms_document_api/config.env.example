# Listen on a private/VPN interface. Use 127.0.0.1 behind a reverse proxy.
OPENSMS_API_HOST=0.0.0.0
OPENSMS_API_PORT=8787
OPENSMS_API_DATA_ROOT=./data

# Required. Generate a long random value, for example: openssl rand -hex 32
OPENSMS_DOC_API_TOKEN=replace-with-a-long-random-token

# Use every logical CPU for separate jobs. One workbook still follows its stage order.
OPENSMS_DOCUMENT_WORKERS=auto

OPENSMS_PROCESS_TIMEOUT_SECONDS=1800
OPENSMS_MAX_UPLOAD_MB=100
OPENSMS_API_LOG_LEVEL=INFO

# Optional when the Codex runtime is installed in a non-default location.
# OPENSMS_NODE_MODULES_DIR=/absolute/path/to/node_modules
# NODE_BIN=/absolute/path/to/node
